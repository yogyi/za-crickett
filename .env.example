# Server-side only. Never expose this as NEXT_PUBLIC_GEMINI_API_KEY.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model override. The default is gemini-3.5-flash.
# GEMINI_MODEL=gemini-3.5-flash

# Stripe. The secret key stays on the server. The publishable key is safe in the browser.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
